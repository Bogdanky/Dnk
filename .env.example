# Copiaza acest fisier in ".env" si completeaza valorile tale.
# NU adauga fisierul .env in Git / arhive partajate.

# Token-ul botului, din Discord Developer Portal -> aplicatia ta -> Bot -> Reset Token
DISCORD_TOKEN=

# Client ID (Application ID), din pagina "General Information" a aplicatiei
CLIENT_ID=

# Optional: ID-ul serverului tau de test. Daca il completezi, comenzile
# se inregistreaza instant doar pe acel server (ideal pt. dezvoltare).
# Daca il lasi gol, comenzile se inregistreaza global (dureaza pana la ~1h).
GUILD_ID=

# Optional: ID-ul tau de utilizator Discord (click dreapta pe numele tau,
# cu Developer Mode activat -> Copy User ID). Daca il completezi, doar tu
# vei putea folosi comanda /reload.
OWNER_ID=

# Optional: cheia ta RapidAPI, necesara doar daca vrei filtrul automat NSFW
# (/automod nsfw-filter). Obtine-o de la rapidapi.com, dupa ce te abonezi
# (exista plan gratuit) la api4ai / nsfw3.
RAPIDAPI_KEY=
