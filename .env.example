# Required: Discord Developer Portal
DISCORD_TOKEN=
CLIENT_ID=

# Optional: use a test server for fast slash-command updates
GUILD_ID=

# Recommended: Discord user ID allowed to run owner-only commands
OWNER_ID=

# Optional: required only when /automod nsfw-filter is enabled
RAPIDAPI_KEY=

# Legacy ticket setup fallback; prefer /ticket setup per server
MOD_ROLE_ID=
TICKET_CATEGORY_ID=
