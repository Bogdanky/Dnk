# Required: create a Discord application and bot in the Discord Developer Portal.
DISCORD_TOKEN=
CLIENT_ID=

# Optional: register slash commands only in a development server for fast updates.
GUILD_ID=

# Recommended: Discord user ID allowed to run owner-only commands (/reload, /shutdown, /booba).
# If unset, owner-only commands remain disabled.
OWNER_ID=

# Optional: required only when /automod nsfw-filter is enabled.
RAPIDAPI_KEY=

# Legacy fallback for existing ticket setup; prefer /ticket setup per server.
MOD_ROLE_ID=
TICKET_CATEGORY_ID=
